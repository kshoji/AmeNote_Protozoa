[submodule "lib/tusb_ump"]
	path = lib/tusb_ump
	url = git@github.com:kshoji/tusb_ump.git
[submodule "lib/tinyusb"]
	path = lib/tinyusb
	url = https://github.com/hathach/tinyusb.git
[submodule "lib/Pico-PIO-USB"]
